@{
    var lesson = ViewData["Lesson"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Caching Academy</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <button class="menu-toggle" type="button" aria-label="Open lessons menu" aria-expanded="false"><span class="menu-icon"><i></i><i></i><i></i></span>Lessons</button>
        <a class="brand" href="/">Caching Academy</a>
        <nav class="topbar-links">
            <a href="/swagger" target="_blank">Swagger</a>
        </nav>
    </header>
    <div class="shell">
        <aside class="sidebar">
            <div class="sidebar-head">
                <div><b>Caching Academy</b><small>7 levels &middot; 28 lessons</small></div>
                <button class="menu-close" type="button" aria-label="Close lessons menu">&times;</button>
            </div>
            <a class="nav-item @(lesson == "home" ? "active" : "")" href="/"><span class="nav-num">&#9733;</span><span>Course map</span></a>

            <div class="nav-group"><span class="nav-level">1</span>Fundamentals</div>
            <a class="nav-item @(lesson == "l1-index" ? "active" : "")" href="/Level1"><span class="nav-num">1.1</span><span>What is caching?</span></a>
            <a class="nav-item @(lesson == "l1-first" ? "active" : "")" href="/Level1/FirstCache"><span class="nav-num">1.2</span><span>Your first cache</span></a>
            <a class="nav-item @(lesson == "l1-expiration" ? "active" : "")" href="/Level1/Expiration"><span class="nav-num">1.3</span><span>Expiration</span></a>
            <a class="nav-item @(lesson == "l1-eviction" ? "active" : "")" href="/Level1/Eviction"><span class="nav-num">1.4</span><span>Size limits and eviction</span></a>

            <div class="nav-group"><span class="nav-level">2</span>HTTP caching</div>
            <a class="nav-item @(lesson == "l2-index" ? "active" : "")" href="/Level2"><span class="nav-num">2.1</span><span>Cache-Control headers</span></a>
            <a class="nav-item @(lesson == "l2-validation" ? "active" : "")" href="/Level2/Validation"><span class="nav-num">2.2</span><span>ETag and 304</span></a>
            <a class="nav-item @(lesson == "l2-response" ? "active" : "")" href="/Level2/ResponseCaching"><span class="nav-num">2.3</span><span>Response caching</span></a>
            <a class="nav-item @(lesson == "l2-output" ? "active" : "")" href="/Level2/OutputCaching"><span class="nav-num">2.4</span><span>Output caching</span></a>
            <a class="nav-item @(lesson == "l2-cdn" ? "active" : "")" href="/Level2/Cdn"><span class="nav-num">2.5</span><span>CDNs and static files</span></a>
            <div class="nav-group"><span class="nav-level">3</span>Caching strategies</div>
            <a class="nav-item @(lesson == "l3-index" ? "active" : "")" href="/Level3"><span class="nav-num">3.1</span><span>Read strategies</span></a>
            <a class="nav-item @(lesson == "l3-write" ? "active" : "")" href="/Level3/WriteStrategies"><span class="nav-num">3.2</span><span>Write-through and write-around</span></a>
            <a class="nav-item @(lesson == "l3-behind" ? "active" : "")" href="/Level3/WriteBehind"><span class="nav-num">3.3</span><span>Write-behind</span></a>
            <a class="nav-item @(lesson == "l3-refresh" ? "active" : "")" href="/Level3/RefreshAhead"><span class="nav-num">3.4</span><span>Refresh-ahead</span></a>
            <div class="nav-group"><span class="nav-level">4</span>Distributed caching</div>
            <a class="nav-item @(lesson == "l4-index" ? "active" : "")" href="/Level4"><span class="nav-num">4.1</span><span>Why distributed?</span></a>
            <a class="nav-item @(lesson == "l4-distributed" ? "active" : "")" href="/Level4/DistributedCache"><span class="nav-num">4.2</span><span>IDistributedCache and Redis</span></a>
            <a class="nav-item @(lesson == "l4-serialization" ? "active" : "")" href="/Level4/Serialization"><span class="nav-num">4.3</span><span>Serialization</span></a>
            <a class="nav-item @(lesson == "l4-hybrid" ? "active" : "")" href="/Level4/HybridCache"><span class="nav-num">4.4</span><span>HybridCache</span></a>
            <div class="nav-group"><span class="nav-level">5</span>Redis in depth</div>
            <a class="nav-item @(lesson == "l5-index" ? "active" : "")" href="/Level5"><span class="nav-num">5.1</span><span>Redis data types</span></a>
            <a class="nav-item @(lesson == "l5-usecases" ? "active" : "")" href="/Level5/UseCases"><span class="nav-num">5.2</span><span>Leaderboard and rate limiting</span></a>
            <a class="nav-item @(lesson == "l5-pubsub" ? "active" : "")" href="/Level5/PubSubLocks"><span class="nav-num">5.3</span><span>Pub/Sub and locks</span></a>
            <a class="nav-item @(lesson == "l5-ops" ? "active" : "")" href="/Level5/Operations"><span class="nav-num">5.4</span><span>Running Redis</span></a>
            <div class="nav-group"><span class="nav-level">6</span>Invalidation</div>
            <a class="nav-item @(lesson == "l6-index" ? "active" : "")" href="/Level6"><span class="nav-num">6.1</span><span>Invalidation strategies</span></a>
            <a class="nav-item @(lesson == "l6-consistency" ? "active" : "")" href="/Level6/Consistency"><span class="nav-num">6.2</span><span>Race conditions and consistency</span></a>
            <div class="nav-group"><span class="nav-level">7</span>Advanced problems</div>
            <a class="nav-item @(lesson == "l7-index" ? "active" : "")" href="/Level7"><span class="nav-num">7.1</span><span>Cache stampede</span></a>
            <a class="nav-item @(lesson == "l7-penetration" ? "active" : "")" href="/Level7/Penetration"><span class="nav-num">7.2</span><span>Penetration and Bloom filters</span></a>
            <a class="nav-item @(lesson == "l7-avalanche" ? "active" : "")" href="/Level7/Avalanche"><span class="nav-num">7.3</span><span>Cache avalanche</span></a>
            <a class="nav-item @(lesson == "l7-multilevel" ? "active" : "")" href="/Level7/MultiLevel"><span class="nav-num">7.4</span><span>Hot keys and multi-level caching</span></a>
            <a class="nav-item @(lesson == "l7-monitoring" ? "active" : "")" href="/Level7/Monitoring"><span class="nav-num">7.5</span><span>Monitoring and other technologies</span></a>
        </aside>
        <div class="sidebar-backdrop"></div>
        <main class="content">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/story.js" asp-append-version="true"></script>
    <script src="~/js/presenter.js" asp-append-version="true"></script>
    @for (var level = 1; level <= 7; level++)
    {
        <script src="~/js/stories/level@(level).js" asp-append-version="true"></script>
    }
    <script src="~/js/stories/deep.js" asp-append-version="true"></script>
    <script src="~/js/stories/realworld.js" asp-append-version="true"></script>
    <script>StoryPlayer.mountAll();</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
