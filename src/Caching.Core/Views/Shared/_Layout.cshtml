@{
    var lesson = ViewData["Lesson"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Caching Academy</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">Caching Academy</a>
        <nav class="topbar-links">
            <a href="/swagger" target="_blank">Swagger</a>
        </nav>
    </header>
    <div class="shell">
        <aside class="sidebar">
            <a class="nav-item @(lesson == "home" ? "active" : "")" href="/">Course map</a>

            <div class="nav-group">Level 1: Fundamentals</div>
            <a class="nav-item @(lesson == "l1-index" ? "active" : "")" href="/Level1">1.1 What is caching?</a>
            <a class="nav-item @(lesson == "l1-first" ? "active" : "")" href="/Level1/FirstCache">1.2 Your first cache</a>
            <a class="nav-item @(lesson == "l1-expiration" ? "active" : "")" href="/Level1/Expiration">1.3 Expiration</a>
            <a class="nav-item @(lesson == "l1-eviction" ? "active" : "")" href="/Level1/Eviction">1.4 Size limits and eviction</a>

            <div class="nav-group">Level 2: HTTP caching</div>
            <a class="nav-item @(lesson == "l2-index" ? "active" : "")" href="/Level2">2.1 Cache-Control headers</a>
            <a class="nav-item @(lesson == "l2-validation" ? "active" : "")" href="/Level2/Validation">2.2 ETag and 304</a>
            <a class="nav-item @(lesson == "l2-response" ? "active" : "")" href="/Level2/ResponseCaching">2.3 Response caching</a>
            <a class="nav-item @(lesson == "l2-output" ? "active" : "")" href="/Level2/OutputCaching">2.4 Output caching</a>
            <a class="nav-item @(lesson == "l2-cdn" ? "active" : "")" href="/Level2/Cdn">2.5 CDNs and static files</a>
            <div class="nav-group">Level 3: Caching strategies</div>
            <a class="nav-item @(lesson == "l3-index" ? "active" : "")" href="/Level3">3.1 Read strategies</a>
            <a class="nav-item @(lesson == "l3-write" ? "active" : "")" href="/Level3/WriteStrategies">3.2 Write-through and write-around</a>
            <a class="nav-item @(lesson == "l3-behind" ? "active" : "")" href="/Level3/WriteBehind">3.3 Write-behind</a>
            <a class="nav-item @(lesson == "l3-refresh" ? "active" : "")" href="/Level3/RefreshAhead">3.4 Refresh-ahead</a>
            <div class="nav-group">Level 4: Distributed caching</div>
            <a class="nav-item @(lesson == "l4-index" ? "active" : "")" href="/Level4">4.1 Why distributed?</a>
            <a class="nav-item @(lesson == "l4-distributed" ? "active" : "")" href="/Level4/DistributedCache">4.2 IDistributedCache and Redis</a>
            <a class="nav-item @(lesson == "l4-serialization" ? "active" : "")" href="/Level4/Serialization">4.3 Serialization</a>
            <a class="nav-item @(lesson == "l4-hybrid" ? "active" : "")" href="/Level4/HybridCache">4.4 HybridCache</a>
            <div class="nav-group muted">Level 5: Redis in depth</div>
            <div class="nav-group muted">Level 6: Invalidation</div>
            <div class="nav-group muted">Level 7: Advanced problems</div>
        </aside>
        <main class="content">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
